# Copy this file to .env and fill it in. Never share or commit .env.

# Your website address
DOMAIN=aarzu.pk
SITE_URL=https://aarzu.pk

# Set to 1 when the shop runs behind Cloudflare Tunnel, Caddy or nginx
# (Docker sets this for you). Leave empty when visitors connect directly.
TRUST_PROXY=

# Admin dashboard password (/admin) — at least 10 characters
ADMIN_PASSWORD=change-me-to-a-long-password

# ---- New-order email alerts (Gmail example) ----
# Gmail: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste the 16 letters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=
MAIL_FROM=Aarzu <yourname@gmail.com>
# Who gets the "New order" alert (comma-separate several emails)
ORDER_ALERT_EMAIL=yourname@gmail.com

# ---- Instant Telegram alerts on your phone (optional) ----
# 1) In Telegram, message @BotFather, send /newbot, copy the token here.
# 2) Send any message to your new bot, then message @userinfobot to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
